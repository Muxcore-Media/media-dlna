# MuxCore shared mesh
MUXCORE_GRPC_ADDR=localhost:9090
MUXCORE_MODULE_ID=media-dlna
MUXCORE_INSECURE_DISABLE_TLS=true

# media-dlna (defaults match mvp compose + run-host)
